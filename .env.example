# SpecOps container settings. Copy to .env (git-ignored), then uncomment and fill in what you need.
# Any appsettings value can be set here: nested keys use double underscores (Auth:Providers:Microsoft:ClientId ->
# Auth__Providers__Microsoft__ClientId), list items use an index (Auth:BootstrapAdmins:0 -> Auth__BootstrapAdmins__0).

# --- Who gets the built-in Admin role on first sign-in -------------------------------------------------
# A sign-in ID ("Microsoft:<subject>", shown on the "waiting for approval" page) or a verified email.
# Auth__BootstrapAdmins__0=

# --- Microsoft Entra ID ---------------------------------------------------------------------------------
# App registration redirect URI: https://<your-host>/signin-microsoft
# Auth__Providers__Microsoft__Authority=https://login.microsoftonline.com/<tenant-id>/v2.0
# Auth__Providers__Microsoft__ClientId=
# Auth__Providers__Microsoft__ClientSecret=
# Auth__Providers__Microsoft__AllowedTenantIds__0=

# --- Google (optional) ----------------------------------------------------------------------------------
# OAuth client redirect URI: https://<your-host>/signin-google
# Auth__Providers__Google__ClientId=
# Auth__Providers__Google__ClientSecret=

# --- Any other OpenID Connect provider (Keycloak, Authentik, Okta...) (optional) ------------------------
# Auth__Providers__Keycloak__DisplayName=Company SSO
# Auth__Providers__Keycloak__Authority=https://sso.example.com/realms/ops
# Auth__Providers__Keycloak__ClientId=
# Auth__Providers__Keycloak__ClientSecret=

# --- Approve new users automatically if their verified email is in one of these domains (optional) ------
# Auth__AutoApproveEmailDomains__0=contoso.com

# --- Host name(s) SpecOps is served on (recommended in production) --------------------------------------
# AllowedHosts=specops.contoso.com

# --- Behind your own reverse proxy / load balancer: trust its address so client IPs and HTTPS are right --
# Proxy__KnownProxies__0=10.0.0.5
# Proxy__KnownNetworks__0=10.0.0.0/24

# --- Hosting under a sub-path, e.g. https://tools.contoso.com/specops ----------------------------------
# PathBase=/specops
