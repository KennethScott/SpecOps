{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md"],
      "options": { "proseWrap": "preserve" }
    },
    {
      "files": ["appsettings*.json", "specops*.json", "launchSettings.json", "global.json", "dotnet-tools.json"],
      "options": { "trailingComma": "none" }
    }
  ]
}
