<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="@BaseHref" />
    <script>
        // Apply the theme before first paint (user choice, else OS preference).
        (function () {
            try {
                var t = localStorage.getItem('specops-theme');
                if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
            } catch (e) { }
        })();
    </script>
    <ResourcePreloader />
    <link rel="icon" type="image/png" href="img/logo.png" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["SpecOps.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body class="min-h-screen bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <Routes @rendermode="PageRenderMode" ClientIp="@ClientIp" />
    <ReconnectModal />
    <script src="_content/BlazorMonaco/jsInterop.js"></script>
    <script>var require = { paths: { vs: '_content/BlazorMonaco/lib/monaco-editor/min/vs' } };</script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
    <script src="@Assets["js/specops.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Account pages render as static HTML (they set cookies); everything else is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private string BaseHref => $"{HttpContext.Request.PathBase}/";

    // Captured here (after forwarded-headers processing) because HttpContext isn't available inside a circuit.
    private string? ClientIp => HttpContext.Connection.RemoteIpAddress?.ToString();
}
