@inherits LayoutComponentBase
@inject ScriptService Scripts

<div class="flex min-h-screen flex-col">
    <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-900/85">
        <div class="mx-auto flex h-14 max-w-7xl items-center gap-4 px-4">
            <a href="" class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
                <img src="img/logo.png" alt="" class="size-7 rounded-full" />
                <span>SpecOps</span>
            </a>

            <AuthorizeView>
                <nav class="flex min-w-0 flex-1 items-center gap-1 overflow-x-auto [scrollbar-width:none]">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Scripts</NavLink>
                    <NavLink class="nav-link" href="runs">Runs</NavLink>
                    @if (Scripts.GetAccess(context.User).IsAdmin)
                    {
                        <NavLink class="nav-link" href="terminal">Terminal</NavLink>
                        <NavLink class="nav-link" href="admin/users">Users</NavLink>
                    }
                </nav>

                <div class="flex shrink-0 items-center gap-1">
                    <ThemeToggle />
                    <span class="hidden max-w-48 truncate px-2 text-sm text-slate-600 sm:inline dark:text-slate-300" title="@context.User.Identity?.Name">
                        @context.User.DisplayName()
                    </span>
                    <form method="post" action="account/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn-ghost px-2" title="Sign out">
                            <Icon Name="log-out" />
                            <span class="sr-only">Sign out</span>
                        </button>
                    </form>
                </div>
            </AuthorizeView>
        </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-6">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet class="fixed inset-x-0 bottom-0 z-50 hidden items-center justify-between gap-4 bg-rose-600 px-4 py-3 text-sm text-white">
    Something went wrong. Reload the page to continue.
    <span>
        <a href="." class="reload font-semibold underline">Reload</a>
        <span class="dismiss ml-3 cursor-pointer">✕</span>
    </span>
</div>
