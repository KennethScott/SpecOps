@page "/admin/config/credentials"
@attribute [Authorize(Policy = AuthenticationSetup.AdminPolicy)]
@inject CredentialVault Vault
@inject IScriptCatalog Catalog

<PageTitle>Credentials · Configure · SpecOps</PageTitle>

<ConfigPage Title="Configure" Errors="_errors" Message="@_message"
            Description="Accounts scripts can use without anyone seeing the password. Add a Credential parameter to a script and choose which of these it may use; the script gets a PSCredential.">
    <Actions>
        <button type="button" class="btn-secondary" @onclick="Add" disabled="@(_drafts.Exists(d => d.IsNew) || !RendererInfo.IsInteractive)"><Icon Name="plus" /> Add credential</button>
    </Actions>
    <ChildContent>
        @if (_drafts.Count == 0)
        {
            <EmptyState Title="No credentials" Icon="lock">Store service accounts here instead of putting passwords in scripts.</EmptyState>
        }

        <div class="grid gap-4">
            @foreach (var draft in _drafts)
            {
                var usedBy = draft.IsNew ? [] : CredentialVault.UsedBy(draft.Id, Catalog.Scripts);
                <form class="card grid gap-4 p-5 sm:grid-cols-2 lg:grid-cols-4" @onsubmit="() => SaveAsync(draft)">
                    <Field Label="Id" Help="@(draft.IsNew ? "Used by scripts; can't be changed later." : null)">
                        <input class="input font-mono" @bind="draft.Id" disabled="@(!draft.IsNew)" aria-label="Credential id" placeholder="ad-service" />
                    </Field>
                    <Field Label="Name">
                        <input class="input" @bind="draft.Name" aria-label="Credential name" placeholder="AD service account" />
                    </Field>
                    <Field Label="User name">
                        <input class="input font-mono" @bind="draft.UserName" aria-label="User name" placeholder="CONTOSO\svc-specops" autocomplete="off" />
                    </Field>
                    <Field Label="Password" Help="@(draft.IsNew ? null : "Leave blank to keep the current one.")">
                        <input type="password" class="input" @bind="draft.Password" aria-label="Password" autocomplete="new-password"
                               placeholder="@(draft.IsNew ? "" : "••••••••")" />
                    </Field>
                    <div class="sm:col-span-2">
                        <Field Label="Description">
                            <input class="input" @bind="draft.Description" aria-label="Credential description" />
                        </Field>
                    </div>
                    <div class="flex flex-wrap items-end justify-between gap-3 sm:col-span-2">
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            @if (draft.IsNew)
                            {
                                <text>Not saved yet.</text>
                            }
                            else
                            {
                                <text>Changed @draft.UpdatedAtUtc.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture) by @draft.UpdatedBy.</text>
                                <br />
                                <text>@(usedBy.Count == 0 ? "Not used by any script." : $"Used by: {string.Join(", ", usedBy.Select(s => s.Name))}")</text>
                            }
                        </p>
                        <div class="flex gap-2">
                            <button type="button" class="btn-ghost py-2 text-rose-600 disabled:text-slate-400" @onclick="() => DeleteAsync(draft)" disabled="@(_busy || usedBy.Count > 0)"
                                    title="@(usedBy.Count > 0 ? "Remove it from those scripts first" : "Delete")">
                                <Icon Name="trash" /> @(draft.IsNew ? "Discard" : "Delete")
                            </button>
                            <button type="submit" class="btn-primary" disabled="@_busy"><Icon Name="save" /> Save</button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </ChildContent>
</ConfigPage>

@code {
    /// <summary>A credential being edited. The password is only ever typed in, never loaded.</summary>
    private sealed class Draft
    {
        public bool IsNew { get; init; }
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string UserName { get; set; } = "";
        public string? Password { get; set; }
        public string? Description { get; set; }
        public DateTime UpdatedAtUtc { get; init; }
        public string UpdatedBy { get; init; } = "";
    }

    private List<Draft> _drafts = [];
    private IReadOnlyList<string> _errors = [];
    private string? _message;
    private bool _busy;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [CascadingParameter(Name = "ClientIp")]
    private string? ClientIp { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _drafts =
        [
            .. (await Vault.ListAsync()).Select(c => new Draft
            {
                Id = c.Id, Name = c.Name, UserName = c.UserName, Description = c.Description, UpdatedAtUtc = c.UpdatedAtUtc, UpdatedBy = c.UpdatedBy,
            }),
        ];

    private void Add() => _drafts.Insert(0, new Draft { IsNew = true });

    private async Task SaveAsync(Draft draft)
    {
        _busy = true;
        _message = null;
        var info = new CredentialInfo(draft.Id, draft.Name, draft.UserName, draft.Description, default, "");
        _errors = await Vault.SaveAsync((await AuthState).User, info, draft.Password, draft.IsNew, ClientIp);
        _busy = false;
        if (_errors.Count == 0)
        {
            _message = $"Saved '{draft.Name.Trim()}'.";
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Draft draft)
    {
        _message = null;
        _errors = [];
        if (draft.IsNew)
        {
            _drafts.Remove(draft);
            return;
        }

        _busy = true;
        var error = await Vault.DeleteAsync((await AuthState).User, draft.Id, Catalog.Scripts, ClientIp);
        _busy = false;
        _errors = error is null ? [] : [error];
        if (error is null)
        {
            _message = $"Deleted '{draft.Name}'.";
            await LoadAsync();
        }
    }
}
