@page "/terminal"
@attribute [Authorize(Policy = AuthenticationSetup.AdminPolicy)]
@implements IAsyncDisposable
@inject ScriptService Scripts
@inject IJSRuntime JS

<PageTitle>Terminal · SpecOps</PageTitle>

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Terminal</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">
            Run ad-hoc PowerShell on the server. <kbd class="rounded border border-slate-300 px-1 text-xs dark:border-slate-700">Ctrl</kbd>+<kbd class="rounded border border-slate-300 px-1 text-xs dark:border-slate-700">Enter</kbd> runs it.
            Each run starts in a fresh runspace unless you pick a profile.
        </p>
    </div>
    <div class="flex items-center gap-2">
        <select class="input w-48" @bind="_profile" aria-label="Runspace profile" disabled="@IsRunning">
            <option value="">Isolated runspace</option>
            @foreach (var profile in Scripts.RunspaceProfiles)
            {
                <option value="@profile.Name">Profile: @profile.Name</option>
            }
        </select>
        <button type="button" class="btn-primary" @onclick="RunAsync" disabled="@(IsRunning || _editor is null)">
            <Icon Name="play" /> @(IsRunning ? "Running…" : "Run")
        </button>
    </div>
</div>

@if (_error is not null)
{
    <p class="mb-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700 dark:bg-rose-950 dark:text-rose-300">@_error</p>
}

<div class="grid gap-4 xl:grid-cols-2">
    <div class="relative overflow-hidden rounded-xl border border-slate-200 shadow-sm dark:border-slate-800">
        <div @ref="_editorHost" class="h-[36rem]"></div>
        @if (_editorState != EditorState.Ready)
        {
            <div class="absolute inset-0 flex items-center justify-center bg-slate-50 text-sm text-slate-500 dark:bg-slate-900 dark:text-slate-400">
                @(_editorState == EditorState.Failed ? "The code editor couldn't load. Reload the page to try again." : "Loading editor…")
            </div>
        }
    </div>
    <OutputConsole Run="_run" OnCancel="Cancel" RunFinished="() => { }" HeightClass="h-[33.5rem]" EmptyText="Write some PowerShell and press Run." />
</div>

@code {
    private const string StorageKey = "specops-terminal-code";

    // Monaco (ES modules), bundled by esbuild from Client/editor; see Client/build-editor.mjs.
    private const string EditorModule = "./lib/editor/specops-editor.js";

    private const string Starter = """
        # Ad-hoc PowerShell. Output, errors, warnings, verbose and progress all stream live.
        $PSVersionTable.PSVersion
        Get-Process | Sort-Object CPU -Descending | Select-Object -First 5 Name, Id, CPU
        """;

    private enum EditorState { Loading, Ready, Failed }

    private ElementReference _editorHost;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<Terminal>? _self;
    private EditorState _editorState = EditorState.Loading;
    private ScriptRun? _run;
    private string _profile = "";
    private string? _error;
    private ClaimsPrincipal _user = new();

    [CascadingParameter(Name = "ClientIp")]
    private string? ClientIp { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool IsRunning => _run is { IsFinished: false };

    protected override async Task OnInitializedAsync() => _user = (await AuthState).User;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            // Restore what was in the editor last time (kept in this browser only).
            var saved = await JS.TryInvokeAsync<string?>("specops.storage.get", StorageKey);
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", EditorModule);
            _editor = await _module.InvokeAsync<IJSObjectReference>(
                "createEditor",
                _editorHost,
                string.IsNullOrEmpty(saved) ? Starter : saved,
                _self);
            _editorState = EditorState.Ready;
        }
        catch (JSException)
        {
            _editorState = EditorState.Failed;
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        StateHasChanged();
    }

    /// <summary>Ctrl/Cmd+Enter in the editor. Not a Blazor UI event, so it asks for a re-render itself.</summary>
    [JSInvokable]
    public async Task RunFromShortcut()
    {
        await RunAsync();
        StateHasChanged();
    }

    private async Task RunAsync()
    {
        if (_editor is null || IsRunning)
        {
            return;
        }

        string code;
        try
        {
            code = await _editor.InvokeAsync<string>("getValue");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _error = "Couldn't read the editor contents. Reload the page and try again.";
            return;
        }

        await JS.TryInvokeVoidAsync("specops.storage.set", StorageKey, code);

        var result = await Scripts.StartCodeAsync(_user, code, _profile, ClientIp);
        _error = result.Error;
        if (result.Run is not null)
        {
            _run = result.Run;
        }
    }

    private async Task Cancel()
    {
        if (_run is not null)
        {
            await Scripts.CancelAsync(_user, _run.Id);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editor is not null)
            {
                await _editor.InvokeVoidAsync("dispose");
                await _editor.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser is gone; nothing to clean up on that side.
        }

        _self?.Dispose();
    }
}
