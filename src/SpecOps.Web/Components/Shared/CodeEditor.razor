@implements IAsyncDisposable
@inject IJSRuntime JS

@* The Monaco PowerShell editor (lazy-loaded ES module bundle, see Client/editor). Ctrl/Cmd+S raises OnSave. *@
<div class="relative">
    <div @ref="_host" class="@HeightClass"></div>
    @if (_state != EditorState.Ready)
    {
        <div class="absolute inset-0 flex items-center justify-center bg-white text-sm text-slate-500 dark:bg-slate-900">
            @(_state == EditorState.Failed ? "The code editor couldn't load. Reload the page to try again." : "Loading editor…")
        </div>
    }
</div>

@code {
    private const string EditorModule = "./lib/editor/specops-editor.js";

    private enum EditorState { Loading, Ready, Failed }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _editor;
    private DotNetObjectReference<CodeEditor>? _self;
    private EditorState _state = EditorState.Loading;

    /// <summary>Text shown when the editor first loads.</summary>
    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public string HeightClass { get; set; } = "h-[32rem]";

    public bool IsReady => _editor is not null;

    /// <summary>The editor's current text, or null if it isn't loaded (or the browser has gone away).</summary>
    public async Task<string?> GetValueAsync()
    {
        if (_editor is null)
        {
            return null;
        }

        try
        {
            return await _editor.InvokeAsync<string>("getValue");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            return null;
        }
    }

    public async Task SetValueAsync(string text)
    {
        if (_editor is not null)
        {
            try
            {
                await _editor.InvokeVoidAsync("setValue", text);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", EditorModule);
            _editor = await _module.InvokeAsync<IJSObjectReference>("createEditor", _host, Value, _self, new { save = nameof(SaveFromShortcut) });
            _state = EditorState.Ready;
        }
        catch (JSException)
        {
            _state = EditorState.Failed;
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        StateHasChanged();
    }

    /// <summary>Ctrl/Cmd+S in the editor.</summary>
    [JSInvokable]
    public Task SaveFromShortcut() => InvokeAsync(() => OnSave.InvokeAsync());

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_editor is { } editor)
            {
                _editor = null;
                await editor.InvokeVoidAsync("dispose");
                await editor.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }

        _self?.Dispose();
    }
}
