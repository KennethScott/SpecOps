@* A labelled form field for the admin pages: label, the input (ChildContent), optional help text. *@
<div class="grid content-start gap-1.5">
    <span class="text-sm font-medium">@Label</span>
    @ChildContent
    @if (Help is not null)
    {
        <span class="text-xs text-slate-500 dark:text-slate-400">@Help</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Help { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
