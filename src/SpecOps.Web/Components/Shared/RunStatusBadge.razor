<span class="badge @Css">
    @if (Status is RunStatus.Running or RunStatus.Queued)
    {
        <span class="size-1.5 animate-pulse rounded-full bg-current"></span>
    }
    @Text
</span>

@code {
    [Parameter, EditorRequired]
    public RunStatus Status { get; set; }

    private string Text => Status switch
    {
        RunStatus.CompletedWithErrors => "Completed with errors",
        RunStatus.TimedOut => "Timed out",
        _ => Status.ToString(),
    };

    private string Css => Status switch
    {
        RunStatus.Queued => "bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300",
        RunStatus.Running => "bg-sky-100 text-sky-800 dark:bg-sky-950 dark:text-sky-300",
        RunStatus.Succeeded => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300",
        RunStatus.CompletedWithErrors => "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300",
        RunStatus.Cancelled => "bg-slate-200 text-slate-700 dark:bg-slate-800 dark:text-slate-300",
        _ => "bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300",
    };
}
