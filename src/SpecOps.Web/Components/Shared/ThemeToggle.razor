@* Handled by a delegated click listener in specops.js (inline onclick handlers are blocked by the CSP). *@
<button type="button" class="btn-ghost px-2" data-theme-toggle title="Toggle light/dark theme">
    <span class="dark:hidden"><Icon Name="moon" /></span>
    <span class="hidden dark:inline"><Icon Name="sun" /></span>
    <span class="sr-only">Toggle theme</span>
</button>
