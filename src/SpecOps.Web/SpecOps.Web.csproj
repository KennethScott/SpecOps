<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Local secrets (e.g. Auth:Providers:*:ClientSecret) via dotnet user-secrets, from this folder. -->
    <UserSecretsId>92479a83-6d13-480a-ba47-b6a49a39a9a7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpecOps.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpecOps.Core\SpecOps.Core.csproj" />
    <ProjectReference Include="..\SpecOps.Data\SpecOps.Data.csproj" />
  </ItemGroup>

  <!--
    Client assets (generated, not committed). Needs Node.js 22+.
      - Tailwind CSS: Styles/app.css -> wwwroot/css/app.css (use `npm run watch:css` while editing markup)
      - Code editor:  Client/editor -> wwwroot/lib/editor (Monaco, bundled by esbuild; Terminal page only)
    npm ci reruns whenever package-lock.json changes. Pass -p:SkipClientBuild=true to skip all of this.
  -->
  <ItemGroup>
    <TailwindInputs Include="Styles/**/*.css;Components/**/*.razor;package-lock.json" />
    <EditorInputs Include="Client/**/*.js;Client/**/*.mjs;package-lock.json" />
  </ItemGroup>

  <Target
    Name="NpmInstall"
    Condition="'$(SkipClientBuild)' != 'true'"
    Inputs="package-lock.json"
    Outputs="node_modules/.package-lock.json"
  >
    <Exec Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target
    Name="BuildTailwindCss"
    DependsOnTargets="NpmInstall"
    BeforeTargets="BeforeBuild"
    Condition="'$(SkipClientBuild)' != 'true'"
    Inputs="@(TailwindInputs)"
    Outputs="wwwroot/css/app.css"
  >
    <Exec Command="npm run build:css" />
  </Target>

  <Target
    Name="BuildEditor"
    DependsOnTargets="NpmInstall"
    BeforeTargets="BeforeBuild"
    Condition="'$(SkipClientBuild)' != 'true'"
    Inputs="@(EditorInputs)"
    Outputs="wwwroot/lib/editor/specops-editor.js"
  >
    <Exec Command="npm run build:editor" />
  </Target>

  <!-- Files created during the build aren't in the evaluation-time wwwroot glob; add them so they're served/published. -->
  <Target Name="IncludeClientOutputs" AfterTargets="BuildTailwindCss;BuildEditor" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <Content Include="wwwroot/css/app.css;wwwroot/lib/editor/**/*" Exclude="@(Content)" />
    </ItemGroup>
  </Target>
</Project>
