{
  "SpecOps": {
    // Database, logs, keys and (by default) specops.json + scripts live here. Relative to the app folder.
    "DataDirectory": "data"
    // "ConfigFile": "data/specops.json"
  },

  "Auth": {
    // These emails get the built-in Admin role when they sign in (first admin / lockout recovery).
    "BootstrapAdmins": [],
    // New users with a verified email in these domains skip the approval queue.
    "AutoApproveEmailDomains": [],
    "DevSignIn": false,
    "Providers": {
      // Providers without a ClientId are ignored. Keep secrets in environment variables or user-secrets,
      // e.g. Auth__Providers__Microsoft__ClientSecret.
      "Microsoft": {
        "Type": "OpenIdConnect",
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "ClientId": "",
        "ClientSecret": "",
        "GroupsClaim": "groups"
      },
      "Google": {
        "Type": "Google",
        "DisplayName": "Google",
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },

  // Behind a reverse proxy: list its address(es) so X-Forwarded-* headers are trusted. Loopback is always trusted.
  "Proxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  // "PathBase": "/specops",
  // "HttpsRedirection": false,

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
