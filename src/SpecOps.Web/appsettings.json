{
  "SpecOps": {
    // Database, logs, keys and (by default) specops.json + scripts live here. Relative to the app folder.
    "DataDirectory": "data",
    // "ConfigFile": "data/specops.json"
    // Log files (data/logs, shown on the Logs page) older than this many days are deleted.
    "LogRetentionDays": 30
  },

  "Auth": {
    // These people get the built-in Admin role when they sign in (first admin / lockout recovery). Use a sign-in ID
    // ("Microsoft:<subject>", shown on the "waiting for approval" page) or an email. Emails only match when the
    // provider verifies them (Google), or the provider has TrustEmail: true.
    "BootstrapAdmins": [],
    // New users with a verified email in these domains skip the approval queue.
    "AutoApproveEmailDomains": [],
    "DevSignIn": false,
    "Providers": {
      // Providers without a ClientId are ignored. Keep secrets in environment variables or user-secrets,
      // e.g. Auth__Providers__Microsoft__ClientSecret.
      "Microsoft": {
        "Type": "OpenIdConnect",
        "DisplayName": "Microsoft",
        "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "ClientId": "",
        "ClientSecret": "",
        "GroupsClaim": "groups",
        // Only accept sign-ins from your tenant (strongly recommended; a warning is logged in production without it).
        "AllowedTenantIds": [],
        // Entra emails aren't verified by default; only set true together with AllowedTenantIds.
        "TrustEmail": false
      },
      "Google": {
        "Type": "Google",
        "DisplayName": "Google",
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  },

  // Behind a reverse proxy: list its address(es) so X-Forwarded-* headers are trusted. Loopback is always trusted.
  "Proxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  // "PathBase": "/specops",
  // "HttpsRedirection": false,

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  // In production, set this to the host name(s) SpecOps is served on, e.g. "specops.contoso.com".
  "AllowedHosts": "*"
}
